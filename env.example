# Web App
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=changeme-super-secret-key-for-auth

# SMTP Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@email.com
SMTP_PASS=your_app_password

# Database
DATABASE_URL=postgresql://raymed:raymed123@localhost:5432/raymed

# Redis (opcional - fallback para cache in-memory)
REDIS_URL=redis://localhost:6379

# Ray API Configuration
RAY_API_BASE=https://api.plataformaray.com.br
RAY_API_KEY=
RAY_API_TIMEOUT=30000
RAY_API_RETRY_ATTEMPTS=3

# LLM Configuration (escolha um provider)
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini

# OpenAI
OPENAI_API_KEY=

# Anthropic
ANTHROPIC_API_KEY=

# Google Gemini
GOOGLE_API_KEY=

# Application Settings
NODE_ENV=development
LOG_LEVEL=info

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Cache Settings
CACHE_TTL_MEDICATIONS=900000
CACHE_TTL_PRICES=300000
CACHE_TTL_LABS=900000

# Alert Settings
DEFAULT_PRICE_DROP_THRESHOLD=0.05
DEFAULT_DAILY_VARIATION_THRESHOLD=0.05
ALERT_BATCH_SIZE=50
MAX_SUBSCRIPTIONS_PER_USER=100

# Cron Settings
CRON_INGEST_ENABLED=true
CRON_ANALYZE_ENABLED=true
CRON_NOTIFY_ENABLED=true
